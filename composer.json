{
    "name": "skoolwala/backend",
    "description": "Skoolwala Backend API",
    "type": "project",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "application/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (!file_exists('application/config/database.php')) { echo 'Database config not found!'; exit(1); }\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
